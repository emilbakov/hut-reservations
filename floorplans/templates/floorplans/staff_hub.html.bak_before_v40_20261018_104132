{% load summitdesk_nav %}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>SummitDesk | {{ hut.name }} Staff Hub</title>
<style>
:root{font-family:system-ui,-apple-system,sans-serif;color:#173d33;background:#f4f7f3}*{box-sizing:border-box}body{margin:0}.wrap{max-width:1180px;margin:auto;padding:22px}.head{background:#153f34;color:white;padding:26px;border-radius:20px;margin-bottom:20px}.head small{color:#c9e4b4}h1{margin:6px 0;font-size:clamp(24px,4vw,34px)}h2{font-size:19px;margin:0 0 16px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:14px}.card{background:white;border:1px solid #dce7dc;border-radius:15px;padding:19px;box-shadow:0 2px 8px #163d3210}.num{font-size:30px;font-weight:750}.muted{color:#60736b;font-size:14px}.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin:18px 0 28px}.link{display:block;background:white;color:#164537;text-decoration:none;border:1px solid #dce7dc;border-radius:13px;padding:17px;font-weight:650}.link:hover,.link:focus{border-color:#91b951;background:#f2f9e7}.link span{display:block;font-weight:400;font-size:13px;color:#60736b;margin-top:5px}.section{margin-top:26px}.task{display:flex;justify-content:space-between;gap:12px;padding:13px 0;border-bottom:1px solid #edf0eb}.task:last-child{border-bottom:0}.pill{border-radius:30px;background:#eaf2d6;padding:5px 9px;font-size:12px;white-space:nowrap}a:focus-visible{outline:3px solid #94b850;outline-offset:2px}@media(max-width:520px){.wrap{padding:12px}.head{padding:20px}.task{flex-direction:column}}
</style></head><body>{% summitdesk_nav %}<main class="wrap">
<header class="head"><small>SUMMITDESK · STAFF WORKSPACE</small><h1>{{ hut.name }}</h1><div>{{ today|date:"l, j F Y" }} · {% if manager %}Manager dashboard{% else %}My cleaner dashboard{% endif %}</div></header>
<div class="grid">
{% if manager %}<div class="card"><div class="muted">Occupied bed places today</div><div class="num">{{ occupied_beds }} <span class="muted">/ {{ capacity }}</span></div></div><div class="card"><div class="muted">Arrivals today · bed places</div><div class="num">{{ arrivals }}</div></div><div class="card"><div class="muted">Departures today · bed places</div><div class="num">{{ departures }}</div></div>{% endif %}
<div class="card"><div class="muted">Cleaning tasks open</div><div class="num">{{ counts.open }}</div></div><div class="card"><div class="muted">Cleaning in progress</div><div class="num">{{ counts.in_progress }}</div></div><div class="card"><div class="muted">Cleaning completed</div><div class="num">{{ counts.done }}</div></div>
</div>
<!-- v37-daily-overview -->
{% if manager %}
<section class="section" aria-labelledby="v37-daily-title">
  <h2 id="v37-daily-title">Today's confirmed booking snapshot</h2>
  <div class="grid">
    <div class="card"><div class="muted">Confirmed occupied bed places today</div><div class="num">{{ v37_confirmed_beds_today }}</div></div>
    <div class="card"><div class="muted">Confirmed booking value for tonight</div><div class="num">{{ v37_booking_value_today|floatformat:2 }}</div><div class="muted">Estimated booking value, not payments received</div></div>
    <div class="card"><div class="muted">Tomorrow's confirmed arrivals · bed places</div><div class="num">{{ v37_arrivals_tomorrow }}</div></div>
  </div>
  <p class="muted">Tonight uses confirmed reservations only, with check-out excluded. Values use the stored per-bed nightly rate. The existing top-row occupied/arrival/departure counts include pending holds.</p>
</section>
{% endif %}
<section class="section"><h2>Workspace</h2><nav class="links" aria-label="Staff tools">
{% if manager %}<a class="link" href="{% url 'floorplans:staff_calendar' hut.pk %}">Reservation calendar<span>Availability and numbered beds</span></a><a class="link" href="{% url 'floorplans:staff_overview' hut.pk %}">Operations overview<span>Arrivals, departures, occupancy</span></a><a class="link" href="{% url 'floorplans:staff_housekeeping' hut.pk %}">Housekeeping board<span>Bed readiness and maintenance</span></a><a class="link" href="{% url 'floorplans:cleaner_team' hut.pk %}">Cleaning team<span>{{ cleaner_count }} team memberships</span></a><a class="link" href="{% url 'floorplans:cleaner_invitations' hut.pk %}">Invite cleaners<span>Manage onboarding invitations</span></a>{% endif %}
<a class="link" href="{% url 'floorplans:staff_tasks' hut.pk %}">{% if manager %}Manage cleaning tasks{% else %}My cleaning tasks{% endif %}<span>Assignments, priorities and progress</span></a>
</nav></section>
<!-- SUMMITDESK_V36_MANAGER_INSIGHTS -->
{% if manager %}
<section class="section" aria-labelledby="v36-insights-title">
  <h2 id="v36-insights-title">Manager insights</h2>
  <nav class="links" aria-label="Manager analytics and audit tools">
    <a class="link" href="{% url 'floorplans:staff_analytics' hut.pk %}">Reservation analytics<span>Occupancy, booking trends and room utilization</span></a>
    <a class="link" href="{% url 'floorplans:staff_financial_analytics' hut.pk %}">Booking value analytics<span>Confirmed and pending booking value, room trends and CSV export</span></a>
    <a class="link" href="{% url 'floorplans:staff_audit_dashboard' hut.pk %}">Reservation audit<span>Staff activity, reservation changes and CSV export</span></a>
  </nav>
</section>
{% endif %}
<section class="section card"><h2>{% if manager %}Today's cleaning tasks{% else %}My tasks today{% endif %}</h2>
{% for task in tasks %}<div class="task"><div><strong>{{ task.bed.room.name }} · Bed {{ task.bed.number }}</strong><div class="muted">{{ task.get_priority_display }} priority{% if manager and task.assignee %} · {{ task.assignee.get_username }}{% endif %}</div></div><span class="pill">{{ task.get_status_display }}</span></div>{% empty %}<p class="muted">No cleaning tasks scheduled for today.</p>{% endfor %}
{% if task_total > 8 %}<p class="muted">Showing the first 8 of {{ task_total }} tasks. Open cleaning tasks to see all.</p>{% endif %}
</section>{% if manager %}
<!-- V38_FORECAST_START -->
<section class="section card" aria-labelledby="v38-forecast-title">
  <h2 id="v38-forecast-title">Next 7 days · Operations forecast</h2>
  <p class="muted">Confirmed and pending bed places, expected arrivals/departures, closures and scheduled cleaning tasks. Arrivals/departures count bed places, not individual guests.</p>
  <div style="overflow-x:auto">
    <table style="width:100%;min-width:780px;border-collapse:collapse;text-align:left">
      <thead><tr><th scope="col">Day</th><th scope="col">Confirmed beds</th><th scope="col">Pending beds</th><th scope="col">Free beds</th><th scope="col">Arrivals</th><th scope="col">Departures</th><th scope="col">Closed beds</th><th scope="col">Cleaning tasks</th></tr></thead>
      <tbody>{% for day in forecast_v38 %}
        <tr style="border-top:1px solid #dce7dc">
          <th scope="row" style="padding:11px 6px">{{ day.day|date:"D, j M" }}</th>
          <td>{{ day.occupied }} / {{ day.available_capacity }}</td><td>{{ day.pending }}</td><td>{{ day.free }}</td><td>{{ day.arrivals }}</td><td>{{ day.departures }}</td><td>{{ day.closed }}</td><td>{{ day.tasks }}</td>
        </tr>{% if day.over_capacity %}<tr><td colspan="8" style="color:#a22">Warning: booked/held places exceed available capacity for this day.</td></tr>{% endif %}
      {% endfor %}</tbody>
    </table>
  </div>
</section>
<!-- V38_FORECAST_END -->
{% endif %}
<!-- V39_ALERTS_START -->
{% if manager %}
<section class="section card" aria-labelledby="v39-alerts-heading">
  <h2 id="v39-alerts-heading">Operations alerts · Next 7 days</h2>
  <p class="muted">Read-only capacity and preparation checks. Alerts are indicators, not proof of an individual bed conflict.</p>
  {% for alert in alerts_v39 %}
    <div class="task">
      <div><strong>{{ alert.title }}</strong><div class="muted">{{ alert.day|date:"D, j M" }} · {{ alert.detail }}</div></div>
      <span class="pill">{{ alert.level|title }}</span>
    </div>
  {% empty %}
    <p class="muted">No operational alerts for the next seven days.</p>
  {% endfor %}
</section>
{% endif %}
<!-- V39_ALERTS_END -->
</main></body></html>
