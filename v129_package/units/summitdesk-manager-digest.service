[Unit]
Description=SummitDesk daily manager guest request digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/hut-reservations
Environment=DJANGO_SETTINGS_MODULE=config.settings_postgres
EnvironmentFile=/etc/hut-reservations/postgres.env
EnvironmentFile=/etc/hut-reservations/manager-digest.env
ExecStart=/home/deploy/hut-reservations/myprojectenv/bin/python manage.py send_manager_request_digest --send
NoNewPrivileges=true
PrivateTmp=true
