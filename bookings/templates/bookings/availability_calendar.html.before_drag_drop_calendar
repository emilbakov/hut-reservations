{% extends "bookings/base.html" %}
{% block title %}Availability calendar{% endblock %}
{% block content %}
<style>
.av-scroll{overflow-x:auto;max-width:100%;border:1px solid #d1d5db;border-radius:12px}.av-table{border-collapse:separate;border-spacing:0;font-size:.8rem;min-width:max-content;width:100%}.av-table th,.av-table td{padding:.45rem;text-align:center;border-bottom:1px solid #e5e7eb;border-right:1px solid #e5e7eb;vertical-align:top;min-width:48px}.av-table th:first-child,.av-table td:first-child{position:sticky;left:0;background:var(--surface,#fff);min-width:175px;z-index:2;text-align:left}.av-table thead th{background:#f3f4f6;color:#111827}.av-open{background:#ecfdf5;color:#065f46}.av-limited{background:#fef3c7;color:#92400e}.av-full{background:#fee2e2;color:#991b1b}.av-over{background:#7f1d1d;color:#fff}.av-number{font-weight:700}.av-detail{font-size:.72rem;line-height:1.5}.av-detail summary{cursor:pointer;text-decoration:underline}.av-toolbar{display:flex;gap:1rem;flex-wrap:wrap;align-items:center;margin:1rem 0}.av-toolbar a{padding:.4rem .7rem;border:1px solid #d1d5db;border-radius:8px}.av-key{display:flex;gap:1rem;flex-wrap:wrap;margin:1rem 0}.av-key span{padding:.25rem .6rem;border-radius:5px}
</style>
<h1>Availability calendar — {{ first|date:"F Y" }}</h1>
<p>Read-only occupancy. Check-out dates do not occupy beds. Pending and confirmed reservations count toward occupancy; cancelled reservations do not.</p>
<form method="get" class="av-toolbar">
<label>Hut <select name="hut">
{% if request.user.is_superuser %}<option value="">All huts</option>{% endif %}
{% for hut in huts %}<option value="{{ hut.slug }}" {% if selected_slug == hut.slug %}selected{% endif %}>{{ hut.name }}</option>{% endfor %}
</select></label>
<label>Year <input name="year" type="number" min="2000" max="2100" value="{{ first.year }}" required></label>
<label>Month <input name="month" type="number" min="1" max="12" value="{{ first.month }}" required></label>
<button type="submit">Show calendar</button>
</form>
<div class="av-toolbar">
<a href="?year={{ prev_month.year }}&month={{ prev_month.month }}{% if selected_slug %}&hut={{ selected_slug|urlencode }}{% endif %}{% if room_filter %}&room={{ room_filter }}{% endif %}">← Previous</a>
<a href="?year={{ next_month.year }}&month={{ next_month.month }}{% if selected_slug %}&hut={{ selected_slug|urlencode }}{% endif %}{% if room_filter %}&room={{ room_filter }}{% endif %}">Next →</a>
</div>
<p><strong>{{ total_beds }}</strong> beds across displayed rooms · <strong>{{ occupied_bed_nights }}</strong> occupied bed-nights · <strong>{{ overbooked_room_nights }}</strong> overbooked room-nights</p>
<div class="av-key"><span class="av-open">Available</span><span class="av-limited">Limited</span><span class="av-full">Full</span><span class="av-over">Overbooked</span></div>
<p><a href="{% url 'bookings:calendar_create' %}{% if selected_slug %}?hut={{ selected_slug|urlencode }}{% endif %}">+ Create reservation</a></p>
<div class="av-scroll" role="region" aria-label="Monthly room availability" tabindex="0">
<table class="av-table"><thead><tr><th scope="col">Room / beds</th>{% for day in days %}<th scope="col">{{ day|date:"D" }}<br>{{ day.day }}</th>{% endfor %}</tr></thead>
<tbody>{% for row in rows %}<tr><th scope="row">{{ row.room.hut.name }}<br>{{ row.room.name }}<br><small>Capacity {{ row.room.capacity }}</small></th>
{% for cell in row.days %}<td class="{% if cell.overbooked %}av-over{% elif cell.full %}av-full{% elif cell.available <= 2 %}av-limited{% else %}av-open{% endif %}" title="{{ cell.day }}: {{ cell.booked }} occupied of {{ row.room.capacity }}">
<a href="{% url 'bookings:calendar_create' %}?check_in={{ cell.day|date:'Y-m-d' }}&amp;room={{ row.room.pk }}{% if selected_slug %}&amp;hut={{ selected_slug|urlencode }}{% endif %}" title="Create booking for this date">+ Book</a><br>
<span class="av-number">{{ cell.available }}</span><br><small>free</small>
{% if cell.reservations %}<details class="av-detail"><summary>{{ cell.booked }} booked</summary>{% for r in cell.reservations %}<div><a href="{% url 'bookings:calendar_edit' r.code %}{% if selected_slug %}?hut={{ selected_slug|urlencode }}{% endif %}">{{ r.code }}</a> · {{ r.guest }} · {{ r.beds }} bed{{ r.beds|pluralize }}</div>{% endfor %}</details>{% endif %}
{% if cell.overbooked %}<strong>Overbooked!</strong>{% endif %}
</td>{% endfor %}</tr>{% empty %}<tr><td colspan="32">No rooms available for this selection.</td></tr>{% endfor %}</tbody></table>
</div>
{% endblock %}
