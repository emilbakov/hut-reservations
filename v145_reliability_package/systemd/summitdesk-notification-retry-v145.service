[Unit]
Description=SummitDesk v145 reservation notification retries
After=network-online.target

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/home/deploy/hut-reservations
Environment=DJANGO_SETTINGS_MODULE=config.settings_postgres
EnvironmentFile=/etc/hut-reservations/postgres.env
ExecStart=/home/deploy/hut-reservations/myprojectenv/bin/python manage.py retry_reservation_notifications --settings=config.settings_postgres --apply --limit 20
TimeoutStartSec=600
UMask=0077
